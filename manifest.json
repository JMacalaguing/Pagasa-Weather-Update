{
  "manifest_version": 3,
  "name": "PAGASA Weather Alert Monitor",
  "version": "3.1.0",
  "description": "Monitors PAGASA Mindanao MINPRSD advisories directly from pagasa.dost.gov.ph \u2014 Rainfall, Thunderstorm, and Special Forecasts with voice alerts.",
  "permissions": [
    "sidePanel",
    "notifications",
    "storage",
    "alarms",
    "tabs",
    "tts"
  ],
  "host_permissions": [
    "https://www.pagasa.dost.gov.ph/*",
    "https://ntfy.sh/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.pagasa.dost.gov.ph/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {
    "default_title": "Open PAGASA Monitor"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}